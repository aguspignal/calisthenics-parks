# Copy to .env and fill in. EXPO_PUBLIC_* values are bundled into the app, so only public keys go here.
# Supabase dashboard > Project Settings > API: project URL and publishable (anon) key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Google Cloud > Clients > Web application client ID (public). Used for native Google sign-in.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
